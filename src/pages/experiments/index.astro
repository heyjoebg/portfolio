---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../components/ui/CaseStudyCard.astro';

// Drafts show up in dev so they can be previewed, never in production.
const allExperiments = await getCollection('experiments', ({ data }) => import.meta.env.DEV || !data.draft);
const experiments = allExperiments.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout
  title="AI Experiments"
  description="This is where I build and ship small products; it's my playground for vibe-coding, prototyping in code, and exploring AI as part of the design process."
>
  <div class="main-title">
    <h1 class="main-heading">Experiments</h1>
  </div>
  <div class="main-container">
    <p class="heyjoe_paragraph mb-50">
      <strong>Experiments</strong> is where I build and ship small products outside of work—fast, messy, and real.
      It's my playground for vibe-coding, prototyping in code, and exploring AI as part of the design process.
      Not polished case studies, just honest snapshots of how I think, make decisions, and stay current.
    </p>
    <div class="case-studies-grid">
      {
        experiments.map((e) => (
          <CaseStudyCard title={e.data.title} subtitle={e.data.tagline} slug={e.id} href={`/experiments/${e.id}`} />
        ))
      }
    </div>
  </div>
</BaseLayout>
